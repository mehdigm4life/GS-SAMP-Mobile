<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/launcher_dialog_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat_bold"
            android:letterSpacing="0.08"
            android:text="SERVER DETAILS"
            android:textColor="@color/launcher_accent"
            android:textSize="10sp" />
        <ImageView
            android:id="@+id/server_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Close"
            android:padding="8dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/server_hostname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/montserrat_bold"
        android:maxLines="2"
        android:text="Server name"
        android:textColor="@color/launcher_text"
        android:textSize="19sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="@color/launcher_outline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/launcher_card"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ADDRESS" android:textColor="@color/launcher_text_muted" android:textSize="10sp" />
            <TextView android:id="@+id/server_ip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:ellipsize="middle" android:gravity="end" android:maxLines="1" android:text="127.0.0.1" android:textColor="@color/launcher_text" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PORT" android:textColor="@color/launcher_text_muted" android:textSize="10sp" />
            <TextView android:id="@+id/server_port" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="end" android:text="7777" android:textColor="@color/launcher_text" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PLAYERS" android:textColor="@color/launcher_text_muted" android:textSize="10sp" />
            <TextView android:id="@+id/server_online" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="end" android:text="0/0" android:textColor="@color/launcher_accent_bright" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MODE" android:textColor="@color/launcher_text_muted" android:textSize="10sp" />
            <TextView android:id="@+id/server_mode" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:ellipsize="end" android:gravity="end" android:maxLines="1" android:text="Roleplay" android:textColor="@color/launcher_text" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LANGUAGE" android:textColor="@color/launcher_text_muted" android:textSize="10sp" />
            <TextView android:id="@+id/server_language" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="end" android:text="English" android:textColor="@color/launcher_text" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/server_password"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/launcher_input_bg"
        android:fontFamily="@font/montserrat_regular"
        android:hint="Server password"
        android:imeOptions="actionDone"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/launcher_text"
        android:textColorHint="@color/launcher_text_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/save_favorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/launcher_button_danger"
            android:fontFamily="@font/montserrat_bold"
            android:text="REMOVE"
            android:textColor="@color/launcher_danger"
            android:textSize="11sp" />
        <Button
            android:id="@+id/server_connect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/launcher_button_primary"
            android:fontFamily="@font/montserrat_bold"
            android:text="CONNECT"
            android:textColor="#17140B"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
