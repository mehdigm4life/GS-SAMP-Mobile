<?xml version="1.0" encoding="utf-8"?>
<!--
    In-app cache installer.

    Everything the player needs to know while several gigabytes are written to
    /storage/emulated/0/GTA lives on this single page: overall progress, the
    file currently being fetched, live speed and ETA, the verification state and
    the pause / resume / cancel controls. The diagnostics pane at the bottom is
    the same information that is appended to
    /storage/emulated/0/GS-SAMP/logcat.txt (diag folder).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cache_bg_gradient"
    android:layoutDirection="locale">

    <View
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-180dp"
        android:layout_marginEnd="-120dp"
        android:background="@drawable/cache_bg_glow"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="22dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <!-- Header  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/cache_title"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/cache_title"
                        android:textColor="@color/cache_text_primary"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/cache_subtitle"
                        android:textColor="@color/cache_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Progress card  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/cache_card_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/cache_percent"
                        android:textColor="@color/cache_accent_start"
                        android:textSize="40sp"
                        tools:text="42%" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_size_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cache_value_unknown"
                            android:textColor="@color/cache_text_primary"
                            android:textSize="14sp"
                            tools:text="1.8 GB" />

                        <TextView
                            android:id="@+id/tv_stage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/cache_stage_idle"
                            android:textColor="@color/cache_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_main"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/cache_progress" />

                <ProgressBar
                    android:id="@+id/pb_file"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="7dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/cache_progress_thin" />

                <TextView
                    android:id="@+id/tv_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:text="@string/cache_stage_idle"
                    android:textColor="@color/cache_text_muted"
                    android:textSize="11sp"
                    tools:text="models/gta3.img" />
            </LinearLayout>

            <!-- Live statistics  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/CacheStatTile">

                    <TextView
                        android:id="@+id/tv_speed"
                        style="@style/CacheStatValue"
                        android:text="@string/cache_value_unknown"
                        tools:text="4.2 MB/s" />

                    <TextView
                        style="@style/CacheStatLabel"
                        android:text="@string/cache_label_speed" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CacheStatTile"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:id="@+id/tv_eta"
                        style="@style/CacheStatValue"
                        android:text="@string/cache_value_unknown"
                        tools:text="7:42" />

                    <TextView
                        style="@style/CacheStatLabel"
                        android:text="@string/cache_label_eta" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/CacheStatTile">

                    <TextView
                        android:id="@+id/tv_downloaded"
                        style="@style/CacheStatValue"
                        android:text="@string/cache_value_unknown"
                        tools:text="3.1 GB" />

                    <TextView
                        style="@style/CacheStatLabel"
                        android:text="@string/cache_label_downloaded" />
                </LinearLayout>

                <LinearLayout
                    style="@style/CacheStatTile"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:id="@+id/tv_files"
                        style="@style/CacheStatValue"
                        android:text="@string/cache_value_unknown"
                        tools:text="812 / 1540" />

                    <TextView
                        style="@style/CacheStatLabel"
                        android:text="@string/cache_label_files" />
                </LinearLayout>
            </LinearLayout>

            <!-- Verification state  -->
            <TextView
                android:id="@+id/tv_verify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/cache_chip_warn"
                android:drawableStart="@drawable/cache_ic_check"
                android:drawablePadding="8dp"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:text="@string/cache_verify_pending"
                android:textColor="@color/cache_warn"
                android:textSize="12sp" />

            <!-- Controls: the primary action and cancel always share one row.
                 Every layout_* attribute is written here instead of coming from
                 a style, so the two buttons can never end up on separate lines. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_toggle"
                    style="@style/CacheActionButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/cache_btn_primary"
                    android:drawableStart="@drawable/cache_ic_download"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/cache_btn_start" />

                <Button
                    android:id="@+id/btn_cancel"
                    style="@style/CacheActionButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/cache_btn_danger"
                    android:drawableStart="@drawable/cache_ic_cancel"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/cache_btn_cancel"
                    android:textColor="@color/cache_error"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Diagnostics  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/cache_card_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cache_log_title"
                    android:textColor="@color/cache_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="9"
                    android:scrollbars="vertical"
                    android:text="@string/cache_log_hint"
                    android:textColor="@color/cache_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
