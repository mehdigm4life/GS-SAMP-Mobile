<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_page_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.12"
                android:text="SAN ANDREAS ONLINE"
                android:textColor="@color/launcher_accent"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/launcher_tab_selected"
                android:fontFamily="@font/montserrat_bold"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="ANDROID"
                android:textColor="@color/launcher_accent_bright"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/montserrat_bold"
            android:lineSpacingExtra="1dp"
            android:text="Welcome to\nSan Andreas"
            android:textColor="@color/launcher_text"
            android:textSize="27sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="Your next story starts in the city."
            android:textColor="@color/launcher_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="142dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/launcher_hero_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:contentDescription="San Andreas Online logo"
                android:scaleType="fitCenter"
                android:src="@drawable/samp_s_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Find your\ncommunity"
                    android:textColor="@color/launcher_text"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Choose a server and jump in."
                    android:textColor="@color/launcher_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/browse_servers"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/launcher_button_primary"
            android:fontFamily="@font/montserrat_bold"
            android:letterSpacing="0.06"
            android:text="BROWSE SERVERS"
            android:textAllCaps="true"
            android:textColor="#17140B"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:background="@color/launcher_accent" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="OUR COMMUNITY"
                android:textColor="@color/launcher_text"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Follow updates, meet players and stay connected."
            android:textColor="@color/launcher_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/launcher_card"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/discord_logo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Open Discord community"
                    android:padding="4dp"
                    android:src="@drawable/discord_logo" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="DISCORD"
                    android:textColor="@color/launcher_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/launcher_card"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/youtube_logo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Open YouTube channel"
                    android:padding="4dp"
                    android:src="@drawable/youtube_logo" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="YOUTUBE"
                    android:textColor="@color/launcher_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/launcher_card"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/internet_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Open San Andreas Online website"
                    android:padding="4dp"
                    android:src="@drawable/internet" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="WEBSITE"
                    android:textColor="@color/launcher_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="YOUR CITY  •  YOUR STORY"
            android:textColor="@color/launcher_text_muted"
            android:textSize="9sp" />
    </LinearLayout>
</ScrollView>
