<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_page_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/textView9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:text="Settings"
            android:textColor="@color/launcher_text"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Make the client feel right for you."
            android:textColor="@color/launcher_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:text="PLAYER NAME"
                android:textColor="@color/launcher_accent"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/settings_nickname"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/launcher_input_bg"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center_vertical"
                android:hint="Enter your nickname"
                android:imeOptions="actionDone"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/launcher_text"
                android:textColorHint="@color/launcher_text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:fontFamily="@font/montserrat_bold"
            android:letterSpacing="0.08"
            android:text="GAMEPLAY"
            android:textColor="@color/launcher_text_muted"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Android keyboard"
                    android:textColor="@color/launcher_text"
                    android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/keyboard_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false"
                    app:thumbTint="@color/launcher_switch_thumb"
                    app:trackTint="@color/launcher_switch_track" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/launcher_outline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Voice chat"
                    android:textColor="@color/launcher_text"
                    android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/voice_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false"
                    app:thumbTint="@color/launcher_switch_thumb"
                    app:trackTint="@color/launcher_switch_track" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/launcher_outline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Show FPS counter"
                    android:textColor="@color/launcher_text"
                    android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/fps_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false"
                    app:thumbTint="@color/launcher_switch_thumb"
                    app:trackTint="@color/launcher_switch_track" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/launcher_outline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Modified game data"
                    android:textColor="@color/launcher_text"
                    android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/modify_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false"
                    app:thumbTint="@color/launcher_switch_thumb"
                    app:trackTint="@color/launcher_switch_track" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/launcher_outline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Monet Loader"
                    android:textColor="@color/launcher_text"
                    android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/monet_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false"
                    app:thumbTint="@color/launcher_switch_thumb"
                    app:trackTint="@color/launcher_switch_track" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Chat message lines"
                    android:textColor="@color/launcher_text"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/messages_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/launcher_tab_selected"
                    android:fontFamily="@font/montserrat_bold"
                    android:minWidth="34dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="5dp"
                    android:text="9"
                    android:textColor="@color/launcher_accent_bright"
                    android:textSize="11sp" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/messages_seekbar"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:max="3"
                android:progress="1"
                android:progressDrawable="@drawable/seekbar_drawable"
                android:splitTrack="false"
                android:thumb="@drawable/seekbar_thumb"
                android:thumbTint="@android:color/transparent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/textView35"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="FPS limit"
                    android:textColor="@color/launcher_text"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/fps_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/launcher_tab_selected"
                    android:fontFamily="@font/montserrat_bold"
                    android:minWidth="44dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="5dp"
                    android:text="60"
                    android:textColor="@color/launcher_accent_bright"
                    android:textSize="11sp" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/fps_seekbar"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:max="3"
                android:progress="1"
                android:progressDrawable="@drawable/seekbar_drawable"
                android:splitTrack="false"
                android:thumb="@drawable/seekbar_thumb"
                android:thumbTint="@android:color/transparent" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:fontFamily="@font/montserrat_bold"
            android:letterSpacing="0.08"
            android:text="CLIENT"
            android:textColor="@color/launcher_text_muted"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/launcher_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_bold"
                android:text="SA-MP version"
                android:textColor="@color/launcher_text"
                android:textSize="13sp" />
            <Spinner
                android:id="@+id/spinner"
                android:layout_width="150dp"
                android:layout_height="44dp"
                android:background="@drawable/launcher_input_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:popupBackground="@color/launcher_surface_high"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" />
        </LinearLayout>

        <TextView
            android:id="@+id/textView14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:fontFamily="@font/montserrat_regular"
            android:text="SA-MP MOBILE  •  COMMUNITY CLIENT"
            android:textColor="@color/launcher_text_muted"
            android:textSize="9sp" />
    </LinearLayout>
</ScrollView>
