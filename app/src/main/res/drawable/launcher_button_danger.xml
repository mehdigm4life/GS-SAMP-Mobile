<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#32E87979"/><stroke android:width="1dp" android:color="@color/launcher_danger"/><corners android:radius="14dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/launcher_surface_high"/><stroke android:width="1dp" android:color="#66E87979"/><corners android:radius="14dp"/></shape>
    </item>
</selector>
