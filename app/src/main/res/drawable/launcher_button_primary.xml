<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#796A45"/><corners android:radius="14dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><gradient android:angle="0" android:startColor="@color/launcher_accent_deep" android:endColor="#E5AA25"/><corners android:radius="14dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><gradient android:angle="0" android:startColor="@color/launcher_accent_bright" android:endColor="@color/launcher_accent"/><corners android:radius="14dp"/></shape>
    </item>
</selector>
