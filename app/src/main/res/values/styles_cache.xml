<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CacheStatTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/cache_tile_bg</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="CacheStatValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cache_text_primary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="CacheStatLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/cache_text_muted</item>
    </style>

    <style name="CacheActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/cache_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Dark, edge-to-edge look for the installer page. Explicit parent so the
         activity can never end up on a non AppCompat/Material theme. -->
    <style name="Theme.SAMPLauncher.CacheInstaller" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/cache_bg_bottom</item>
        <item name="android:statusBarColor">@color/cache_bg_top</item>
        <item name="android:navigationBarColor">@color/cache_bg_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/cache_accent_end</item>
        <item name="colorAccent">@color/cache_accent_start</item>
    </style>
</resources>
