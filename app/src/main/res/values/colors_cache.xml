<?xml version="1.0" encoding="utf-8"?>
<!-- Cache installer colors alias the launcher palette so its download/verify page
     shares the same graphite, gold, text and status colors. -->
<resources>
    <color name="cache_bg_top">@color/launcher_bg</color>
    <color name="cache_bg_mid">@color/launcher_surface</color>
    <color name="cache_bg_bottom">@color/launcher_bg</color>

    <color name="cache_glow">#26F5C542</color>
    <color name="cache_glow_transparent">#00F5C542</color>

    <color name="cache_card">@color/launcher_surface</color>
    <color name="cache_card_stroke">@color/launcher_outline</color>
    <color name="cache_tile">@color/launcher_surface_high</color>

    <color name="cache_accent_start">@color/launcher_accent_bright</color>
    <color name="cache_accent_end">@color/launcher_accent</color>

    <color name="cache_track">@color/launcher_outline</color>

    <color name="cache_text_primary">@color/launcher_text</color>
    <color name="cache_text_secondary">@color/launcher_text_secondary</color>
    <color name="cache_text_muted">@color/launcher_text_muted</color>

    <color name="cache_ok">@color/launcher_success</color>
    <color name="cache_ok_bg">#1F54D69A</color>
    <color name="cache_warn">@color/launcher_accent_bright</color>
    <color name="cache_warn_bg">@color/launcher_accent_tint</color>
    <color name="cache_error">@color/launcher_danger</color>
    <color name="cache_error_bg">#26E87979</color>
    <color name="cache_danger_bg">#26E87979</color>
    <color name="cache_danger_stroke">#66E87979</color>
</resources>
